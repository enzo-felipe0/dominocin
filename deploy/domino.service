[Unit]
Description=Dominó Multiplayer (web, rede local)
After=network.target

[Service]
Type=simple
# Ajuste para o usuário e o caminho reais no servidor:
User=usuario
WorkingDirectory=/home/usuario/domino_web
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
